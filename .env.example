# Copie para .env ou gere automaticamente com: ./scripts/generate-env.sh
# Todas as senhas sao OBRIGATORIAS: o docker compose nao sobe sem elas.
RABBITMQ_USERNAME=orders
RABBITMQ_PASSWORD=troque-por-uma-senha-forte

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=troque-por-uma-senha-forte
MONGO_APP_USER=orders_app
# Use apenas letras e numeros (vai dentro da URI de conexao)
MONGO_APP_PASSWORD=troque-por-uma-senha-forte

# Onde o front-end escuta. Mantenha 127.0.0.1 e exponha via HTTPS (docker-compose.https.yml).
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=3000

# Dominio para HTTPS automatico com Caddy (docker-compose.https.yml)
DOMAIN=

# Simulador da demo (false desliga rajadas, controle do worker e redrive)
SIMULATION_ENABLED=true
WORKER_PROCESSING_DELAY_MS=1200
WORKER_FAILURE_RATE=0.0
